# Copia este archivo como .env (el .env NUNCA se sube a git) y llena el usuario de pruebas.

# Usuario de QA solo para pruebas. Tiene que ser admin, o tener el correo verificado.
E2E_USUARIO=
E2E_PASSWORD=

# A donde apuntan las pruebas. Por defecto QA; las pruebas se niegan a correr contra prod.
# E2E_URL_FRONT=https://qa.shop.novedades-jade.com.mx
# E2E_URL_API=https://qa.backend.novedades-jade.com.mx/mis-productos
